{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Import: merge exports/bartesian-exports.zip",
      "type": "shell",
      "command": "node scripts/import-data.js",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true,
        "close": true,
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "Import: rebuild seed from data/ only",
      "type": "shell",
      "command": "node scripts/import-data.js --from-data",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true,
        "close": true,
        "showReuseMessage": false
      },
      "problemMatcher": []
    }
  ]
}
