{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Serve Bartesian (8099)",
      "type": "node-terminal",
      "request": "launch",
      "command": "python -m http.server 8099",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Import: merge exports/bartesian-exports.zip",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/import-data.js",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "internalConsoleOptions": "openOnSessionStart"
    },
    {
      "name": "Import: rebuild seed from data/ only",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/import-data.js",
      "args": ["--from-data"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "internalConsoleOptions": "openOnSessionStart"
    }
  ]
}
