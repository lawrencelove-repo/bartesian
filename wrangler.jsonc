{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bartesian",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "EMAIL_FROM": "onboarding@resend.dev",
    "AUTHORIZED_EMAILS": "lawrencelove@gmail.com",
    "APP_MODE": "cloudflare"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bartesian-db",
      "database_id": "8170b114-9648-4e2f-8432-30cf1d227362",
      "migrations_dir": "migrations"
    }
  ]
}
