 the following:\u003c\/span\u003e\u003c\/p\u003e\n\u003cdiv id=\"cat_wrapper\"\u003e\n\u003cul\u003e\n\u003cli aria-level=\"1\"\u003e\n\u003cstrong\u003eBlackberry Margarita: \u003c\/strong\u003ea\u003cstrong\u003e \u003c\/strong\u003ejuicy, jammy blend with slightly tart berry flavors and undertones of honeyed fig. \u003c\/li\u003e\n\u003cli aria-level=\"1\"\u003e\n\u003cstrong\u003eMango Margarita:\u003c\/strong\u003e a fruity, juicy blend with mango and lime flavors. \u003c\/li\u003e\n\u003cli\u003e\n\u003cstrong\u003ePassion Fruit Margarita:\u003c\/strong\u003e a sweet, tropical and tangy blend with passion fruit and citrus flavors. \u003cstrong\u003e\u003c\/strong\u003e\n\u003c\/li\u003e\n\u003cli aria-level=\"1\"\u003e\n\u003cstrong\u003ePineapple Margarita: \u003c\/strong\u003ea refreshing blend of tart pineapple, sweet coconut and lime flavors. \u003c\/li\u003e\n\u003c\/ul\u003e\n\u003cp\u003ePlease note: Capsules do not contain alcohol.\u003cspan id=\"dots\"\u003e\u003c\/span\u003e\u003c\/p\u003e\n\u003cdiv id=\"more\"\u003e\n\u003ch2\u003e\u003cstrong\u003eCraft Authentic Margaritas at Home with Bartesian\u003c\/strong\u003e\u003c\/h2\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eCreate your ideal tropical paradise in a margarita glass with our variety pack! Simply add your preferred tequila to your Bartesian cocktail maker glass bottles, press mix, and enjoy on-demand margaritas at home in seconds! \u003c\/span\u003e\u003c\/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eSavor the deep, tart flavors of blackberry, fruity tastes of pineapple, and the citrus aromas of pineapple and classic margarita. Each margarita capsule has its unique taste, but we guarantee you’ll get delicious, ice-cold, refreshing cocktails every time.\u003c\/span\u003e\u003c\/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eEach margarita capsule in this collection contains a unique blend of triple sec, fresh juices including lemon and lime, and other bitters and extracts to create the perfect, tangy margarita. Embrace the exciting flavors of tequila with bold citrus fruits to craft premium cocktails.\u003c\/span\u003e\u003cbr\u003e\u003c\/p\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e","published_at":"2023-04-18T07:59:00-05:00","created_at":"2023-03-27T09:45:21-05:00","updated_at":"2026-10-19T11:11:01-05:00","vendor":"Bartesian","product_type":"Cocktails","tags":["832cap","bartesian_pricing_variety","base-spirit_tequila","bundle-filter__tequila","Cocktails","klaviyoeligible","promo","tequila","tequilla","upsell_recharge","variety-pack"],"variants":[{"id":43136777289927,"title":"8 Capsules","option1":"8 Capsules","option2":null,"option3":null,"sku":"55507","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"24.96","grams":454,"compare_at_price":null,"position":1,"product_id":7646682644679,"created_at":"2023-03-27T09:45:22-05:00","updated_at":"2026-10-19T11:11:01-05:00"},{"id":43136777322695,"title":"32 Capsules","option1":"32 Capsules","option2":null,"option3":null,"sku":"75612M","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"71.99","grams":2722,"compare_at_price":null,"position":2,"product_id":7646682644679,"created_at":"2023-03-27T09:45:22-05:00","updated_at":"2026-10-19T11:11:01-05:00"},{"id":44653143064775,"title":"8 Capsules.","option1":"8 Capsules.","option2":null,"option3":null,"sku":"55507","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"19.99","grams":454,"compare_at_price":null,"position":3,"product_id":7646682644679,"created_at":"2024-10-28T12:32:09-05:00","updated_at":"2026-10-19T11:11:01-05:00"}],"images":[{"id":43775211339975,"created_at":"2025-07-28T14:12:48-05:00","position":1,"updated_at":"2025-07-28T14:13:01-05:00","product_id":7646682644679,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0038\/6049\/6433\/files\/tropical-cocktail-capsules-from